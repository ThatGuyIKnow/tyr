(define (problem parallel-astar-zero-cost)
  (:domain transport)
  (:objects start via goal - location truck - vehicle)
  (:init
    (= (total-cost) 0)
    (at truck start)
    (road start goal) (= (road-length start goal) 7)
    (road start via) (= (road-length start via) 0)
    (road via start) (= (road-length via start) 0)
    (road via goal) (= (road-length via goal) 2)
  )
  (:goal (at truck goal))
  (:metric minimize (total-cost))
)
