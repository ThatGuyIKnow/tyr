(define (problem parallel-astar-reopening)
  (:domain transport)
  (:objects start cheap merge goal - location truck - vehicle)
  (:init
    (= (total-cost) 0)
    (at truck start)
    (road start merge) (= (road-length start merge) 3)
    (road start cheap) (= (road-length start cheap) 1)
    (road cheap merge) (= (road-length cheap merge) 1)
    (road merge goal) (= (road-length merge goal) 100)
  )
  (:goal (at truck goal))
  (:metric minimize (total-cost))
)
